# ============================================================
# GymCoach - Environment variables
# ============================================================
# Copy this file to .env and fill in the values.
# .env is ignored by git (see .gitignore).

# --- Database ---
DATABASE_URL=postgresql://gymcoach:gymcoach_dev_pwd@localhost:5433/gymcoach

POSTGRES_USER=gymcoach
POSTGRES_PASSWORD=gymcoach_dev_pwd
POSTGRES_DB=gymcoach

# --- Authentication ---
# Generate 64 random chars: openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48

USER_EMAIL=you@example.com
USER_PASSWORD=change-me-immediately

NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_EMAIL=demo@gymcoach.app
NEXT_PUBLIC_DEMO_PASSWORD=gymcoachdemo

# --- AI coach ---
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_APP_NAME=GymCoach
OPENROUTER_APP_URL=http://localhost:3030

CODEX_LB_BASE_URL=http://127.0.0.1:8317/v1
CODEX_LB_API_KEY=
CODEX_LB_MODEL=gpt-5.6-sol

# --- YouTube Recipe Search ---
# Get a key at https://console.developers.google.com/ (YouTube Data API v3)
# Leave empty to disable recipe video search.
YOUTUBE_API_KEY=

# --- App ---
NEXTAUTH_URL=http://localhost:3030
# SESSION_COOKIE_SECURE=false
MCP_PUBLIC_URL=
# MCP_ALLOWED_ORIGINS=https://gym.example.com
# MCP_ALLOWED_HOSTS=gym.example.com,gym.example.com:3030
NODE_ENV=development
UPLOADS_DIR=./uploads
