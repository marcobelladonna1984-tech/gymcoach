// GymCoach - Database schema
// Single-user, weightlifting tracking and Claude AI coach.

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  bodyweight        Float?
  displayName       String?
  sex               Sex?
  heightCm          Int?
  goal              TrainingGoal?
  weeklyFrequency   Int?
  unit              WeightUnit         @default(KG)
  deloadUntil       DateTime?
  coachNote         String?
  createdAt         DateTime           @default(now())
  programs          Program[]
  sessions          Session[]
  exercises         Exercise[]
  conversations     Conversation[]
  readinessCheckins ReadinessCheckin[]
  exerciseGoals     ExerciseGoal[]
  bodyweightEntries BodyweightEntry[]
  wellnessEntries   WellnessEntry[]
  bodyMeasurements  BodyMeasurement[]
  volumeTargets     VolumeTarget[]
  progressPhotos    ProgressPhoto[]
  gyms              Gym[]              @relation("GymOwner")
  mcpAccessTokens   McpAccessToken[]
  activeGymId       String?
  activeGym         Gym?               @relation("ActiveGym", fields: [activeGymId], references: [id], onDelete: SetNull)
  nutritionEntries  NutritionEntry[]
}

// Personal access tokens for remote MCP clients such as ChatGPT.
model McpAccessToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  canWrite    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([userId, createdAt])
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum WeightUnit {
  KG
  LB
}

enum TrainingGoal {
  HYPERTROPHY
  STRENGTH
  FAT_LOSS
  RECOMP
  GENERAL_FITNESS
}

// Nutrition entry: a single food/meal log with macros.
// Additive: one row per food item per day. The tracker aggregates by day.
model NutritionEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Name of the food or meal (e.g. "Chicken breast 150g").
  name        String
  // Macronutrients in grams.
  kcal        Int
  proteinG    Float
  carbsG      Float
  fatG        Float
  // Optional meal slot for grouping.
  meal        MealSlot @default(SNACK)
  loggedAt    DateTime @default(now())
  note        String?

  @@index([userId, loggedAt])
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  PRE_WORKOUT
  POST_WORKOUT
}

// Nutrition daily targets per user (optional, falls back to profile-based estimates).
model NutritionTarget {
  id         String   @id @default(cuid())
  userId     String   @unique
  kcal       Int
  proteinG   Float
  carbsG     Float
  fatG       Float
  updatedAt  DateTime @updatedAt
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Exercise {
  id                String                 @id @default(cuid())
  userId            String
  user              User                   @relation(fields: [userId], references: [id])
  name              String
  muscleGroup       MuscleGroup
  category          ExerciseCategory
  defaultRestSec    Int                    @default(90)
  notes             String?
  usesBodyweight    Boolean                @default(false)
  equipmentType     EquipmentType          @default(OTHER)
  createdAt         DateTime               @default(now())
  programExercises  ProgramExercise[]
  sets              Set[]
  goals             ExerciseGoal[]
  gymConfigs        GymExerciseConfig[]
  gymEquipmentLinks GymEquipmentExercise[]

  @@unique([userId, name])
}

enum EquipmentType {
  DUMBBELL
  BARBELL
  MACHINE
  CABLE
  BODYWEIGHT
  CARDIO
  OTHER
}

enum MuscleGroup {
  CHEST
  BACK_WIDTH
  BACK_THICKNESS
  SHOULDERS_FRONT
  SHOULDERS_LATERAL
  SHOULDERS_REAR
  BICEPS
  TRICEPS
  FOREARMS
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  ABS
  LOWER_BACK
  OTHER
}

enum ExerciseCategory {
  COMPOUND
  ISOLATION
  CARDIO
}

model Program {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  name        String
  description String?
  phase       String
  isActive    Boolean   @default(false)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workouts    Workout[]
  sessions    Session[]
}

model Workout {
  id        String            @id @default(cuid())
  programId String
  program   Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  dayOfWeek Int?
  order     Int
  exercises ProgramExercise[]
  sessions  Session[]
}

model ProgramExercise {
  id                 String                @id @default(cuid())
  workoutId          String
  workout            Workout               @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId         String
  exercise           Exercise              @relation(fields: [exerciseId], references: [id])
  order              Int
  targetSets         Int
  targetRepsMin      Int
  targetRepsMax      Int
  targetRIR          Int
  restSec            Int
  tempo              String?
  notes              String?
  supersetGroup      Int?
  autoregulationMode SetAutoregulationMode @default(PRESERVE_RIR)
  fatigueRate        Float?
  loadAdjustmentPct  Float?
}

enum SetAutoregulationMode {
  PRESERVE_RIR
  PRESERVE_REPS
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  programId  String?
  program    Program?  @relation(fields: [programId], references: [id])
  workoutId  String?
  workout    Workout?  @relation(fields: [workoutId], references: [id])
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  notes      String?
  gymId      String?
  gym        Gym?      @relation(fields: [gymId], references: [id], onDelete: SetNull)
  sets       Set[]

  @@index([userId, startedAt])
}

model Gym {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation("GymOwner", fields: [userId], references: [id], onDelete: Cascade)
  name            String
  dumbbellWeights Float[]             @default([])
  plateWeights    Float[]             @default([])
  barWeights      Float[]             @default([])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  activeForUsers  User[]              @relation("ActiveGym")
  sessions        Session[]
  exerciseConfigs GymExerciseConfig[]
  equipment       GymEquipment[]

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model GymExerciseConfig {
  id            String   @id @default(cuid())
  gymId         String
  gym           Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  isAvailable   Boolean  @default(true)
  weightOptions Float[]  @default([])

  @@unique([gymId, exerciseId])
  @@index([exerciseId])
}

model GymEquipment {
  id            String                 @id @default(cuid())
  gymId         String
  gym           Gym                    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name          String
  equipmentType EquipmentType
  description   String?
  manufacturer  String?
  modelName     String?
  quantity      Int                    @default(1)
  weightOptions Float[]                @default([])
  imageUrl      String?
  imageData     Bytes?
  imageMimeType String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  exerciseLinks GymEquipmentExercise[]
  performedSets Set[]

  @@unique([gymId, name])
  @@index([gymId, equipmentType])
}

model GymEquipmentExercise {
  equipmentId String
  equipment   GymEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([equipmentId, exerciseId])
  @@index([exerciseId])
}

model Set {
  id                    String        @id @default(cuid())
  sessionId             String
  session               Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId            String
  exercise              Exercise      @relation(fields: [exerciseId], references: [id])
  gymEquipmentId        String?
  gymEquipment          GymEquipment? @relation(fields: [gymEquipmentId], references: [id], onDelete: SetNull)
  equipmentNameSnapshot String?
  equipmentLoadSnapshot Json?
  setNumber             Int
  weight                Float
  reps                  Int
  rir                   Int?
  durationSec           Int?
  distanceM             Float?
  avgHr                 Int?
  maxHr                 Int?
  track                 Json?
  notes                 String?
  isWarmup              Boolean       @default(false)
  isDropSet             Boolean       @default(false)
  completedAt           DateTime      @default(now())

  @@index([exerciseId, completedAt])
}

model ExerciseGoal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  targetWeight Float
  targetReps   Int
  createdAt    DateTime  @default(now())
  achievedAt   DateTime?

  @@unique([userId, exerciseId])
}

model VolumeTarget {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup
  mev         Int
  mrv         Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, muscleGroup])
}

model BodyweightEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Float
  measuredAt DateTime @default(now())
  note       String?

  @@index([userId, measuredAt])
}

// One row per calendar day of wellness metrics imported from an external
// source (healthexport / Google Sheet "salute"). Weight is deliberately NOT
// stored here: it lives in BodyweightEntry (history) and User.bodyweight (the
// current value), and the import writes both. Steps, sleep and resting/average
// heart rate have no other home in the schema, so they are kept here, one row
// per day, merged (last non-null wins) when the same day appears more than
// once in an import.
model WellnessEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  steps      Int?
  sleepHours Float?
  avgHr      Int?
  source     String?

  @@unique([userId, date])
  @@index([userId, date])
}

model BodyMeasurement {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  site       BodyMeasurementSite
  valueCm    Float
  measuredAt DateTime            @default(now())
  note       String?

  @@index([userId, site, measuredAt])
}

enum BodyMeasurementSite {
  WAIST
  HIPS
  CHEST
  SHOULDERS
  NECK
  ARM_LEFT
  ARM_RIGHT
  FOREARM_LEFT
  FOREARM_RIGHT
  THIGH_LEFT
  THIGH_RIGHT
  CALF_LEFT
  CALF_RIGHT
}

model ProgressPhoto {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  takenAt     DateTime @default(now())
  storagePath String
  mimeType    String
  byteSize    Int
  note        String?
  createdAt   DateTime @default(now())

  @@index([userId, takenAt])
}

model CoachSession {
  id        String    @id @default(cuid())
  userId    String
  weekStart DateTime
  weekEnd   DateTime
  prompt    String    @db.Text
  response  String    @db.Text
  appliedAt DateTime?
  createdAt DateTime  @default(now())
}

model ReadinessCheckin {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readiness    Int
  sleepQuality Int
  soreness     Json?
  note         String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
